# Fastfile for NahjulBalagha

default_platform(:ios)

platform :ios do
  desc "Push a new beta build to TestFlight"
  lane :beta do
    # Increment build number
    increment_build_number(xcodeproj: "NahjulBalagha.xcodeproj")

    # Build the app
    build_app(
      scheme: "NahjulBalagha",
      export_method: "app-store",
      export_options: {
        provisioningProfiles: {
          "com.creativerez.NahjulBalagha" => "NahjulBalagha AppStore"
        }
      }
    )

    # Upload to TestFlight
    upload_to_testflight(
      skip_waiting_for_build_processing: true
    )
  end

  desc "Build the app for testing"
  lane :build_test do
    build_app(
      scheme: "NahjulBalagha",
      export_method: "development",
      skip_package_ipa: true
    )
  end

  desc "Run tests"
  lane :test do
    run_tests(
      scheme: "NahjulBalagha",
      devices: ["iPhone 16"]
    )
  end

  desc "Take screenshots for App Store"
  lane :screenshots do
    capture_screenshots(
      scheme: "NahjulBalagha"
    )
  end

  desc "Upload metadata to App Store Connect"
  lane :upload_metadata do
    deliver(
      skip_screenshots: true,
      skip_binary_upload: true
    )
  end
end